# Optional. Enables the server-side streaming assistant at /api/chat.
# Without it, the in-page advisor still answers from the estimate figures.
ANTHROPIC_API_KEY=
# Model used by /api/chat (optional override).
GRIHA_CHAT_MODEL=claude-haiku-4-5
# Comma-separated origins allowed for cross-origin calls. Leave empty when the
# frontend is served by this app (same origin).
GRIHA_CORS_ORIGINS=
